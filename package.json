{
  "name": "@hey-research-lab/agent-contract",
  "version": "0.2.0",
  "description": "The public contract of HEY's agent answers (AgentIntelligenceResponse v1): Zod schemas, TypeScript types, capability and unknown vocabularies, fixtures and test vectors.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://heyresearch.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-agent-contract.git"
  },
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-agent-contract/issues"
  },
  "keywords": [
    "hey-research",
    "robinhood-chain",
    "ai-agents",
    "agent-contract",
    "zod",
    "json-schema",
    "mcp",
    "a2a"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/agent-intelligence-response.v1.json": "./schema/agent-intelligence-response.v1.json",
    "./schema/agent-intelligence-response.v1.tolerant.json": "./schema/agent-intelligence-response.v1.tolerant.json",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "fixtures/live",
    "fixtures/edge",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "tsup && node scripts/build-schema.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "parity:source": "node scripts/check-source-parity.mjs",
    "parity:refresh": "node scripts/refresh-parity.mjs",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "fixtures:edge": "node scripts/make-edge-fixtures.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11",
    "zod-to-json-schema": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
